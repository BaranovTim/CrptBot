<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, API 26+. The launcher masks this to whatever shape the
     phone uses (circle, squircle, teardrop), so the mark sits inside the
     72dp safe zone of the 108dp canvas and the background is a flat colour
     that can be cropped to any shape without losing anything. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
