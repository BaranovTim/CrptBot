<?xml version="1.0" encoding="utf-8"?>
<!-- The outer card. RemoteViews cannot blur, so the glass is approximated
     with a flat dark fill and a hairline stroke — the same shape the app's
     GlassPanel draws once its blur has resolved. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/w_bg" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/w_stroke" />
</shape>
