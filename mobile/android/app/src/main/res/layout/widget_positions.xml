<?xml version="1.0" encoding="utf-8"?>
<!--
  TRADE LOG WIDGET.

  Summary on top, then the three most recent entries. Open positions sort
  first, because they are the only ones you can still act on.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_panel"
    android:padding="14dp" android:id="@+id/p_root">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_dim" android:textSize="9sp"
                android:text="LOGGED PERFORMANCE" />
            <TextView android:id="@+id/p_net" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/w_green"
                android:textSize="19sp" android:textStyle="bold" android:text="—" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_dim" android:textSize="9sp" android:text="Win rate" />
            <TextView android:id="@+id/p_win" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:background="@drawable/w_chip"
                android:paddingLeft="7dp" android:paddingRight="7dp"
                android:textColor="@color/w_green" android:textSize="11sp"
                android:textStyle="bold" android:text="—" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/w_inner" android:padding="5dp"
            android:layout_marginEnd="4dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_dim" android:textSize="8sp" android:text="PROFIT FACTOR" />
            <TextView android:id="@+id/p_pf" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/w_text"
                android:textSize="11sp" android:textStyle="bold" android:text="—" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/w_inner" android:padding="5dp"
            android:layout_marginEnd="4dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_dim" android:textSize="8sp" android:text="OPEN RISK" />
            <TextView android:id="@+id/p_risk" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/w_amber"
                android:textSize="11sp" android:textStyle="bold" android:text="—" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/w_inner" android:padding="5dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_dim" android:textSize="8sp" android:text="REALISED 24H" />
            <TextView android:id="@+id/p_24h" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/w_green"
                android:textSize="11sp" android:textStyle="bold" android:text="—" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/w_dim"
            android:textSize="9sp" android:text="RECENT MARKET ENTRIES" />
        <TextView android:id="@+id/p_open" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/w_green"
            android:textSize="9sp" android:text="" />
    </LinearLayout>

        <LinearLayout android:id="@+id/p_card1" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/w_row" android:padding="9dp"
            android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/p_pair1" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_text"
                    android:textSize="12sp" android:textStyle="bold" android:text="BTC / USDT" />
                <TextView android:id="@+id/p_side1" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/w_chip"
                    android:paddingLeft="5dp" android:paddingRight="5dp"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/w_green" android:textSize="8sp"
                    android:text="BUY / LONG" />
                <TextView android:id="@+id/p_state1" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/w_cyan" android:textSize="8sp"
                    android:maxLines="1" android:text="ACTIVE" />
                <TextView android:id="@+id/p_pnl1" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_green"
                    android:textSize="12sp" android:textStyle="bold" android:text="+$0.00" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@drawable/w_inner"
                android:padding="6dp" android:layout_marginTop="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_dim" android:textSize="7sp" android:text="SIZE" />
                    <TextView android:id="@+id/p_size1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_text"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_dim" android:textSize="7sp" android:text="ENTRY" />
                    <TextView android:id="@+id/p_entry1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_text"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/p_tplabel1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_dim"
                        android:textSize="7sp" android:text="TP TARGET" />
                    <TextView android:id="@+id/p_tp1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_green"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="end">
                    <TextView android:id="@+id/p_sllabel1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_dim"
                        android:textSize="7sp" android:text="STOP LOSS" />
                    <TextView android:id="@+id/p_sl1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_red"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="5dp">
                <TextView android:id="@+id/p_when1" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="@color/w_dim" android:textSize="8sp"
                    android:maxLines="1" android:text="—" />
                <TextView android:id="@+id/p_note1" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_dim"
                    android:textSize="8sp" android:maxLines="1" android:text="" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/p_card2" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/w_row" android:padding="9dp"
            android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/p_pair2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_text"
                    android:textSize="12sp" android:textStyle="bold" android:text="BTC / USDT" />
                <TextView android:id="@+id/p_side2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/w_chip"
                    android:paddingLeft="5dp" android:paddingRight="5dp"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/w_green" android:textSize="8sp"
                    android:text="BUY / LONG" />
                <TextView android:id="@+id/p_state2" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/w_cyan" android:textSize="8sp"
                    android:maxLines="1" android:text="ACTIVE" />
                <TextView android:id="@+id/p_pnl2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_green"
                    android:textSize="12sp" android:textStyle="bold" android:text="+$0.00" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@drawable/w_inner"
                android:padding="6dp" android:layout_marginTop="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_dim" android:textSize="7sp" android:text="SIZE" />
                    <TextView android:id="@+id/p_size2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_text"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_dim" android:textSize="7sp" android:text="ENTRY" />
                    <TextView android:id="@+id/p_entry2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_text"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/p_tplabel2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_dim"
                        android:textSize="7sp" android:text="TP TARGET" />
                    <TextView android:id="@+id/p_tp2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_green"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="end">
                    <TextView android:id="@+id/p_sllabel2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_dim"
                        android:textSize="7sp" android:text="STOP LOSS" />
                    <TextView android:id="@+id/p_sl2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_red"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="5dp">
                <TextView android:id="@+id/p_when2" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="@color/w_dim" android:textSize="8sp"
                    android:maxLines="1" android:text="—" />
                <TextView android:id="@+id/p_note2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_dim"
                    android:textSize="8sp" android:maxLines="1" android:text="" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/p_card3" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/w_row" android:padding="9dp"
            android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/p_pair3" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_text"
                    android:textSize="12sp" android:textStyle="bold" android:text="BTC / USDT" />
                <TextView android:id="@+id/p_side3" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/w_chip"
                    android:paddingLeft="5dp" android:paddingRight="5dp"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/w_green" android:textSize="8sp"
                    android:text="BUY / LONG" />
                <TextView android:id="@+id/p_state3" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/w_cyan" android:textSize="8sp"
                    android:maxLines="1" android:text="ACTIVE" />
                <TextView android:id="@+id/p_pnl3" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_green"
                    android:textSize="12sp" android:textStyle="bold" android:text="+$0.00" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@drawable/w_inner"
                android:padding="6dp" android:layout_marginTop="6dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_dim" android:textSize="7sp" android:text="SIZE" />
                    <TextView android:id="@+id/p_size3" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_text"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/w_dim" android:textSize="7sp" android:text="ENTRY" />
                    <TextView android:id="@+id/p_entry3" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_text"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/p_tplabel3" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_dim"
                        android:textSize="7sp" android:text="TP TARGET" />
                    <TextView android:id="@+id/p_tp3" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_green"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="end">
                    <TextView android:id="@+id/p_sllabel3" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_dim"
                        android:textSize="7sp" android:text="STOP LOSS" />
                    <TextView android:id="@+id/p_sl3" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/w_red"
                        android:textSize="10sp" android:maxLines="1" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="5dp">
                <TextView android:id="@+id/p_when3" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="@color/w_dim" android:textSize="8sp"
                    android:maxLines="1" android:text="—" />
                <TextView android:id="@+id/p_note3" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/w_dim"
                    android:textSize="8sp" android:maxLines="1" android:text="" />
            </LinearLayout>
        </LinearLayout>
    <TextView android:id="@+id/p_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/w_dim"
        android:textSize="10sp" android:layout_marginTop="10dp"
        android:text="No trades logged yet. Log one at the bottom of any coin's dashboard." />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="9dp">
        <TextView android:id="@+id/p_foot" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/w_dim" android:textSize="9sp"
            android:maxLines="1" android:text="" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/w_green" android:textSize="10sp"
            android:textStyle="bold" android:text="Full journal ›" />
    </LinearLayout>
</LinearLayout>
