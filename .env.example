# Copy to .env and put a real value in. Generate one with:
#   openssl rand -hex 32
#
# The phone sends this as `Authorization: Bearer <token>`. Anyone holding it
# can read your market analysis; nobody holding it can trade, because there is
# nothing here that trades.
TRADINGBOT_TOKEN=replace-me

# Which host interface the API is published on. Leave as loopback unless you
# are using Tailscale, in which case set it to the tailnet address that
# `tailscale ip -4` prints (100.x.y.z) so the phone can reach it.
#
# Do NOT set this to 0.0.0.0. Docker bypasses `ufw`, so that opens port 8787
# to the whole internet on a box that looks firewalled.
BIND_ADDR=127.0.0.1

# Alpaca — US equity bars for the screener and the stocks side.
#
# OPTIONAL. Leave blank and the crypto half works exactly as before; the
# screener reports that it has no data rather than showing an empty table that
# looks like "nothing matched your filters".
#
# A FREE account is enough. Paper-trading keys work for market data — this
# never places an order, and the key it is given cannot: market data is a
# read-only scope.
#
# The secret is shown once, at creation. If you lose it, regenerate rather
# than hunting for it.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Stripe — the subscription. OPTIONAL, like Alpaca above: unset, the app runs
# exactly as it does today and the billing screen says checkout is not set up.
#
# The secret key is the one starting `sk_live_` (or `sk_test_` while trying it
# out). NEVER the `pk_` publishable key, and never commit either.
STRIPE_SECRET_KEY=

# Price ids from the two recurring Products you create in Stripe. These are
# `price_...`, NOT `prod_...` — a Product id is rejected at checkout, and that
# is the single most common mistake here.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Shown by Stripe once, when you add the webhook endpoint. Starts `whsec_`.
# Without it, incoming webhooks are refused rather than trusted unverified —
# anyone can POST to that URL, so an unsigned "payment succeeded" must not
# grant a subscription.
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends the customer back after paying, and where it posts the
# webhook. Must be reachable from a phone — no localhost, no trailing slash.
# Today: https://165.232.127.165.sslip.io
#
# This is the string that breaks when the server IP changes, because sslip.io
# encodes the IP in the hostname. A real domain would make it survive a move.
PUBLIC_BASE_URL=
