# Copy to .env and put a real value in. Generate one with:
#   openssl rand -hex 32
#
# The phone sends this as `Authorization: Bearer <token>`. Anyone holding it
# can read your market analysis; nobody holding it can trade, because there is
# nothing here that trades.
TRADINGBOT_TOKEN=replace-me

# Which host interface the API is published on. Leave as loopback unless you
# are using Tailscale, in which case set it to the tailnet address that
# `tailscale ip -4` prints (100.x.y.z) so the phone can reach it.
#
# Do NOT set this to 0.0.0.0. Docker bypasses `ufw`, so that opens port 8787
# to the whole internet on a box that looks firewalled.
BIND_ADDR=127.0.0.1
